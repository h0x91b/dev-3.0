{
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(git *)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(python3 *)",
      "Bash(curl *)",
      "Bash(md5 *)",
      "Bash(fc-query *)",
      "Bash(pip3 install *)",
      "Bash(gh *)",
      "WebSearch",
      "Bash(dev3:*)",
      "Bash(sed *)",
      "Bash(~/.dev3.0/bin/dev3 *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-approve.sh",
            "args": []
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-approve.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
